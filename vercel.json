{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/solve", "destination": "/api/_ai-gateway?target=solve" },
    { "source": "/api/admin-health", "destination": "/api/admin-tools?route=admin-health" },
    { "source": "/api/admin-delete-exam", "destination": "/api/admin-tools?route=admin-delete-exam" },
    { "source": "/api/admin-delete-exams-bulk", "destination": "/api/admin-tools?route=admin-delete-exams-bulk" },
    { "source": "/api/admin-update-exam", "destination": "/api/admin-tools?route=admin-update-exam" },
    { "source": "/api/client-meta", "destination": "/api/admin-tools?route=client-meta" },
    { "source": "/api/system-incidents", "destination": "/api/system-control?route=incidents" }
  ]
}
