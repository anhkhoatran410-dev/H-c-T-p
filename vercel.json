{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin-health", "destination": "/api/admin-tools?route=admin-health" },
    { "source": "/api/admin-delete-exam", "destination": "/api/admin-tools?route=admin-delete-exam" },
    { "source": "/api/admin-delete-exams-bulk", "destination": "/api/admin-tools?route=admin-delete-exams-bulk" },
    { "source": "/api/admin-update-exam", "destination": "/api/admin-tools?route=admin-update-exam" },
    { "source": "/api/client-meta", "destination": "/api/admin-tools?route=client-meta" },
    { "source": "/api/system-incidents", "destination": "/api/system-control?route=incidents" }
  ]
}
